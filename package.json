{
  "name": "media-vault",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first viewing tracker. Static output, no runtime dependencies.",
  "scripts": {
    "build": "node build/build.js",
    "posters": "node build/tools/omdb-posters.js",
    "links": "node build/tools/link-duplicates.js --write",
    "sweep": "node build/tools/apply-sweep.js",
    "serve": "python3 -m http.server 8000",
    "series": "node build/tools/seriesgraph.js",
    "wiki": "node build/tools/wiki-posters.js",
    "covers": "node build/tools/list-covers.js",
    "list": "node build/tools/import-list.js",
    "rg": "node build/tools/ratingraph.js"
  },
  "devDependencies": {
    "ejs": "^3.1.10"
  }
}