<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <% if (base) { %><base href="<%= base %>" /><% } %>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= u.name %> - Media Vault</title>
    <meta name="description" content="<%= u.page.desc %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Montserrat:wght@400;500;600;700&family=Agdasima:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/universes.css" />
    <link rel="stylesheet" href="assets/css/tracker.css" />
    <link rel="stylesheet" href="assets/css/series.css" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23<%= u.accent.slice(1) %>'/%3E%3C/svg%3E"
    />
  </head>
  <body data-mode="<%= vault.mode %>" data-universe="<%= u.id %>" class="u-<%= u.id %>">
    <div class="page">
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="<%= vault.home %>">
            <span class="brand-mark">MV</span>
            <span>Media Vault</span>
          </a>
          <span class="crumb">/ <%= u.name %></span>
          <span class="topbar-spacer"></span>
          <span id="acctChip"></span>
          <% if (vault.list) { %><a class="btn btn-ghost" href="<%= vault.list %>">★ <%= vault.listLabel %></a><% } %>
          <button class="btn btn-ghost" id="jumpNext" title="Jump to the next unwatched episode">
            Next up ↓
          </button>
        </div>
      </header>

      <section class="hero wrap">
        <p class="eyebrow reveal"><%= u.page.eyebrow %></p>
        <h1 class="reveal" style="--d:60ms">
          <%= u.page.h1a %><br /><span class="hero-accent"><%= u.page.h1b %></span>
        </h1>
        <p class="lede reveal" style="--d:130ms"><%= u.page.lede %></p>
      </section>

      <div class="controls">
        <div class="progress-rail"><i id="progressRail"></i></div>
        <div class="wrap ctrl-summary">
          <div class="ring-wrap">
            <svg class="ring" viewBox="0 0 44 44" aria-hidden="true">
              <circle class="ring-bg" cx="22" cy="22" r="19" />
              <circle class="ring-fg" cx="22" cy="22" r="19" id="ringFg" />
            </svg>
            <span class="ring-label" id="ringLabel">0%</span>
          </div>
          <div class="summary-figures">
            <div class="figure"><b id="figWatched">0</b><span>watched</span></div>
            <div class="figure"><b id="figTotal">0</b><span>episodes</span></div>
            <div class="figure"><b id="figLeft">0</b><span>remaining</span></div>
            <div class="figure"><b id="figTime">0h</b><span>left to watch</span></div>
          </div>
          <span class="topbar-spacer"></span>
          <div class="ctrl-buttons">
            <button class="btn btn-ghost" id="markOngoing" aria-pressed="false">Mark ongoing</button>
            <button class="btn btn-ghost" id="hideWatched" aria-pressed="false">Hide watched</button>
            <button class="btn btn-ghost" id="denseView" aria-pressed="false" title="Ratings only">Compact</button>
            <button class="btn btn-ghost" id="collapseAll">Collapse all</button>
            <button class="btn btn-ghost danger" id="resetShow">Reset</button>
          </div>
        </div>
      </div>

      <main class="wrap series-wrap">
        <p class="rating-key reveal">
          <i class="r-cinema">Absolute Cinema</i>
          <i class="r-awesome">Awesome</i>
          <i class="r-great">Great</i>
          <i class="r-good">Good</i>
          <i class="r-average">Average</i>
          <i class="r-bad">Bad</i>
          <i class="r-garbage">Garbage</i>
        </p>
        <div id="seriesRoot"></div>
      </main>

      <footer class="footer">
        <div class="wrap footer-inner">
          <a class="foot-link" href="pages/analytics.html">📊 Analytics</a>
          <span><%= u.page.footer %></span>
          <span><a href="<%= vault.home %>">← <%= vault.back %></a></span>
        </div>
      </footer>
    </div>

    <script src="assets/js/config.js"></script>
    <script src="assets/js/store.js"></script>
    <script src="assets/js/cloud.js"></script>
    <script src="assets/js/data/merges.js"></script>
    <script src="assets/js/lightbox.js"></script>
    <script src="assets/js/data/_films.js"></script>
    <script src="assets/js/modes.js"></script>
    <script src="assets/js/data/<%= u.id %>.js"></script>
    <script src="assets/js/data/series/<%= u.id %>.js"></script>
    <script src="assets/js/series.js"></script>
    <script src="assets/js/account.js"></script>
  </body>
</html>
