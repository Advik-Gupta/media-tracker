<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <% if (base) { %><base href="<%= base %>" /><% } %>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Analytics — Media Vault</title>
    <meta name="description" content="What your watching actually looks like." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Montserrat:wght@400;500;600;700&family=Agdasima:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/universes.css" />
    <link rel="stylesheet" href="assets/css/tracker.css" />
    <link rel="stylesheet" href="assets/css/home.css" />
    <link rel="stylesheet" href="assets/css/series.css" />
    <link rel="stylesheet" href="assets/css/analytics.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23e3a83b'/%3E%3C/svg%3E" />
  </head>
  <body data-mode="movie" class="u-analytics">
    <div class="page">
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="index.html">
            <span class="brand-mark">MV</span>
            <span>Media Vault</span>
          </a>
          <span class="crumb">/ Analytics</span>
          <span class="topbar-spacer"></span>
          <span id="acctChip"></span>
          <a class="btn btn-ghost" href="pages/watchlist.html">★ My List</a>
        </div>
      </header>

      <section class="hero wrap">
        <p class="eyebrow reveal">Everything you have watched</p>
        <h1 class="reveal" style="--d:60ms">
          The shape<br /><span class="hero-accent">of it all</span>
        </h1>
        <p class="lede reveal" style="--d:130ms">
          Counted from what you have actually ticked, across every vault.
          Switch the filter to narrow it to one library.
        </p>
      </section>

      <main class="wrap" id="analytics"></main>

      <footer class="footer">
        <div class="wrap footer-inner">
          <span>Counted in this browser · nothing leaves it</span>
          <span><a href="index.html">← All libraries</a></span>
        </div>
      </footer>
    </div>

    <script src="assets/js/config.js"></script>
    <script src="assets/js/store.js"></script>
    <script src="assets/js/cloud.js"></script>
    <script src="assets/js/data/merges.js"></script>
    <script src="assets/js/lightbox.js"></script>
    <script src="assets/js/data/_films.js"></script>
    <script src="assets/js/modes.js"></script>
    <script src="assets/js/data/universes.js"></script>
    <script src="assets/js/data/series/_counts.js"></script>
    <script src="assets/js/data/_stats.js"></script>
<% universes.forEach(function (u) { %>    <script src="assets/js/data/<%= u.id %>.js"></script>
<% }); %>
    <script src="assets/js/analytics.js"></script>
    <script src="assets/js/account.js"></script>
  </body>
</html>
