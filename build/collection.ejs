<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <% if (base) { %><base href="<%= base %>" /><% } %>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= c.name %> - Media Vault</title>
    <meta name="description" content="<%= c.name %> - <%= c.tagline %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Inter:wght@400;450;500;600;650;700&family=Agdasima:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/universes.css" />
    <link rel="stylesheet" href="assets/css/home.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23e3a83b'/%3E%3C/svg%3E" />
  </head>
  <body data-mode="<%= vault.mode %>" data-collection="<%= c.id %>" class="u-collection">
    <div class="page">
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="<%= vault.home %>">
            <span class="brand-mark">MV</span>
            <span>Media Vault</span>
          </a>
          <span class="crumb">/ <%= c.name %></span>
          <span class="topbar-spacer"></span>
          <span id="acctChip"></span>
          <span class="crumb" id="colCount"></span>
        </div>
      </header>

      <section class="hero wrap">
        <p class="eyebrow reveal">Collection</p>
        <h1 class="reveal" style="--d:60ms"><%= c.name %></h1>
        <p class="lede reveal" style="--d:130ms">
          <%= c.tagline %>. Open any of them for the full season and episode
          breakdown - progress is tracked there, and counted here.
        </p>

        <div class="hero-stats reveal" style="--d:200ms">
          <div class="hstat"><b id="hsUniverses">0</b><span>series</span></div>
          <div class="hstat"><b id="hsTitles">0</b><span>episodes</span></div>
          <div class="hstat"><b id="hsWatched">0</b><span>watched</span></div>
          <div class="hstat"><b id="hsHours">-</b><span>episodes left</span></div>
        </div>
      </section>

      <section class="wrap section" id="members">
        <div class="section-bar reveal">
          <h2><%= c.name %></h2>
          <input class="section-search" type="search" data-search="<%= c.kind %>"
                 placeholder="Search…" aria-label="Search this collection" />
          <span class="crumb" id="colShown"></span>
        </div>
        <div class="uni-grid" id="<%= c.kind %>Grid"></div>
        <p class="no-results" data-empty="<%= c.kind %>" hidden>Nothing matches that search.</p>
      </section>

      <footer class="footer">
        <div class="wrap footer-inner">
          <a class="foot-link" href="pages/analytics.html">📊 Analytics</a>
          <span><%= universes.length %> series in this collection</span>
          <span><a href="<%= vault.home %>">← <%= vault.back %></a></span>
        </div>
      </footer>
    </div>

    <script src="assets/js/config.js"></script>
    <script src="assets/js/store.js"></script>
    <script src="assets/js/cloud.js"></script>
    <script src="assets/js/data/merges.js"></script>
    <script src="assets/js/data/series/_counts.js"></script>
    <script src="assets/js/lightbox.js"></script>
    <script src="assets/js/data/_films.js"></script>
    <script src="assets/js/modes.js"></script>
    <script src="assets/js/data/universes.js"></script>
    <script src="assets/js/data/collections.js"></script>
<% universes.forEach(function (u) { %>    <script src="assets/js/data/<%= u.id %>.js"></script>
<% }); %>    <script src="assets/js/home.js"></script>
    <script src="assets/js/account.js"></script>
  </body>
</html>
