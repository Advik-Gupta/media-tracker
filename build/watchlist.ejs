<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <% if (base) { %><base href="<%= base %>" /><% } %>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= vault.title %> - Media Vault</title>
    <meta name="description" content="Your own <%= vault.noun %>, alongside every tracked universe." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Inter:wght@400;450;500;600;650;700&family=Agdasima:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/universes.css" />
    <link rel="stylesheet" href="assets/css/tracker.css" />
    <link rel="stylesheet" href="assets/css/home.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%236a9ee8'/%3E%3C/svg%3E" />
  </head>
  <body data-mode="<%= vault.mode %>" class="u-watchlist">
    <div class="page">
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="<%= vault.home %>">
            <span class="brand-mark">MV</span>
            <span>Media Vault</span>
          </a>
          <span class="crumb">/ <%= vault.title %></span>
          <span class="topbar-spacer"></span>
          <span id="acctChip"></span>
          <span class="crumb" id="wlCount"></span>
        </div>
      </header>

      <section class="hero wrap">
        <p class="eyebrow reveal"><%= vault.eyebrow %></p>
        <h1 class="reveal" style="--d:60ms">
          Everything<br /><span class="hero-accent">you mean to watch</span>
        </h1>
        <p class="lede reveal" style="--d:130ms">
          Type any title. If it is in one of the tracked universes you will see it
          suggested - pick it and the entry keeps that poster and stays in sync, so
          ticking it here ticks it there too. Anything else can still be added by name.
        </p>

        <div class="wl-search reveal" style="--d:200ms">
          <input id="wlInput" type="text" autocomplete="off" spellcheck="false"
                 placeholder="<%= vault.mode === "show" ? "Add a series…" : "Add a film…" %>" aria-label="Add a title" />
          <button class="btn btn-accent" id="wlAdd">Add</button>
          <div class="wl-suggest" id="wlSuggest" hidden></div>
        </div>
      </section>

      <main class="wrap list-wrap">
        <div id="wlControls" class="wl-controls"></div>
        <div class="rows" id="wlList"></div>
        <p class="empty" id="wlEmpty">Nothing on your list yet. Search for something above.</p>
      </main>

      <footer class="footer">
        <div class="wrap footer-inner">
          <a class="foot-link" href="pages/analytics.html">📊 Analytics</a>
          <span>Your <%= vault.noun %> · stored in this browser, included in every backup</span>
          <span><a href="<%= vault.home %>">← <%= vault.back %></a></span>
        </div>
      </footer>
    </div>

    <script src="assets/js/config.js"></script>
    <script src="assets/js/store.js"></script>
    <script src="assets/js/cloud.js"></script>
    <script src="assets/js/ratingraph.js"></script>
    <script src="assets/js/data/merges.js"></script>
    <script src="assets/js/lightbox.js"></script>
    <script src="assets/js/data/_films.js"></script>
    <script src="assets/js/data/_details.js"></script>
    <script src="assets/js/modes.js"></script>
    <script src="assets/js/data/universes.js"></script>
<% universes.forEach(function (u) { %>    <script src="assets/js/data/<%= u.id %>.js"></script>
<% }); %>    <script src="assets/js/omdb.js"></script>
    <script src="assets/js/watchlist.js"></script>
    <script src="assets/js/account.js"></script>
  </body>
</html>
