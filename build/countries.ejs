<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <% if (base) { %><base href="<%= base %>" /><% } %>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>By Country - Media Vault</title>
    <meta name="description" content="Browse films by country of origin on a world map." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Montserrat:wght@400;500;600;700&family=Agdasima:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/universes.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap@1.6.0/dist/jsvectormap.css" />
    <link rel="stylesheet" href="assets/css/home.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%234ea8a0'/%3E%3C/svg%3E" />
  </head>
  <body data-mode="<%= vault.mode %>" class="u-countries">
    <div class="page">
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="<%= vault.home %>">
            <span class="brand-mark">MV</span>
            <span>Media Vault</span>
          </a>
          <span class="crumb">/ By Country</span>
          <span class="topbar-spacer"></span>
          <a class="btn btn-ghost" href="<%= vault.list %>">★ <%= vault.listLabel %></a>
          <span class="crumb" id="ctryCount"></span>
        </div>
      </header>

      <section class="hero wrap">
        <p class="eyebrow reveal">World cinema</p>
        <h1 class="reveal" style="--d:60ms">Films by<br /><span class="hero-accent">country</span></h1>
        <p class="lede reveal" style="--d:130ms">
          Click a highlighted country to open its list. The dimmed ones do not have a
          list yet - they light up as soon as one is added.
        </p>
      </section>

      <main class="wrap">
        <div class="map-wrap reveal">
          <div id="mapHolder" class="map-holder">
            <p class="map-loading">Loading the map…</p>
          </div>
                  </div>

        <section class="section">
          <div class="section-bar reveal"><h2>Every country</h2></div>
          <ul class="ctry-grid" id="countryList"></ul>
        </section>
      </main>

      <footer class="footer">
        <div class="wrap footer-inner">
          <a class="foot-link" href="pages/analytics.html">📊 Analytics</a>
          <span>Country lists · click a lit country on the map</span>
          <span><a href="<%= vault.home %>">← <%= vault.back %></a></span>
        </div>
      </footer>
    </div>

    <script src="assets/js/store.js"></script>
    <script src="assets/js/data/merges.js"></script>
    <script src="assets/js/lightbox.js"></script>
    <script src="assets/js/data/_films.js"></script>
    <script src="assets/js/modes.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsvectormap@1.6.0/dist/jsvectormap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsvectormap@1.6.0/dist/maps/world.js"></script>
    <script src="assets/js/data/countries.js"></script>
    <%# Each country's own catalogue, so the map tooltip can show progress. %>
    <% countryLists.forEach((id) => { %>
    <script src="assets/js/data/<%= id %>.js"></script>
    <% }); %>
    <script src="assets/js/countries.js"></script>
  </body>
</html>
