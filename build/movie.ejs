<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <base href="<%= base %>" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Loading - Media Vault</title>
    <meta name="description" content="Everything about one film." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Montserrat:wght@400;500;600;700&family=Agdasima:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/universes.css" />
    <link rel="stylesheet" href="assets/css/tracker.css" />
    <link rel="stylesheet" href="assets/css/home.css" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23e3a83b'/%3E%3C/svg%3E"
    />
  </head>
  <body data-mode="movie" class="u-movieview">
    <div class="page">
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="index.html">
            <span class="brand-mark">MV</span>
            <span>Media Vault</span>
          </a>
          <span class="crumb" id="mvCrumb">/ Loading…</span>
          <span class="topbar-spacer"></span>
          <span id="acctChip"></span>
          <a class="btn btn-ghost" href="pages/watchlist.html">★ My List</a>
        </div>
      </header>

      <main class="wrap" id="mvRoot">
        <div class="view-status"><i class="spinner"></i>Loading…</div>
      </main>

      <footer class="footer">
        <div class="wrap footer-inner">
          <a class="foot-link" href="pages/analytics.html">📊 Analytics</a>
          <span>Details from OMDb · progress stored in this browser</span>
          <span><a href="index.html">← All universes</a></span>
        </div>
      </footer>
    </div>

    <script src="assets/js/config.js"></script>
    <script src="assets/js/store.js"></script>
    <script src="assets/js/cloud.js"></script>
    <script src="assets/js/data/merges.js"></script>
    <script src="assets/js/lightbox.js"></script>
    <script src="assets/js/data/_films.js"></script>
    <script src="assets/js/data/_shelves.js"></script>
    <script src="assets/js/modes.js"></script>
    <script src="assets/js/omdb.js"></script>
    <script src="assets/js/movieview.js"></script>
    <script src="assets/js/account.js"></script>
  </body>
</html>
