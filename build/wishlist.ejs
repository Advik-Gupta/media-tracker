<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <% if (base) { %><base href="<%= base %>" /><% } %>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My List - <%= vault.title %> - Media Vault</title>
    <meta name="description" content="Shows and anime you mean to get to, kept as a reference until you decide." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Montserrat:wght@400;500;600;700&family=Agdasima:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/universes.css" />
    <link rel="stylesheet" href="assets/css/home.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%236a9ee8'/%3E%3C/svg%3E" />
  </head>
  <body data-mode="<%= vault.mode %>" class="u-wishlist">
    <div class="page">
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="<%= vault.home %>">
            <span class="brand-mark">MV</span>
            <span>Media Vault</span>
          </a>
          <span class="crumb">/ My List</span>
          <span class="topbar-spacer"></span>
          <span id="acctChip"></span>
        </div>
      </header>

      <section class="hero wrap">
        <p class="eyebrow reveal">My List &middot; <%= vault.title %></p>
        <h1 class="reveal" style="--d:60ms">
          Worth a look,<br /><span class="hero-accent">not worth deciding on yet.</span>
        </h1>
        <p class="lede reveal" style="--d:130ms">
          Type a name to save it here as a reference - poster, year and a blurb, nothing
          more. It does not join your <%= vault.noun %> until you say so.
        </p>

        <div class="wl-search reveal" style="--d:200ms">
          <input id="wishInput" type="text" autocomplete="off" spellcheck="false"
                 placeholder="<%= vault.mode === "anime" ? "Anime name…" : "Show name…" %>" aria-label="Search a title" />
          <div class="wl-suggest" id="wishSuggest" hidden></div>
        </div>
      </section>

      <main class="wrap">
        <div class="wish-grid" id="wishGrid"></div>
        <p class="empty" id="wishEmpty" hidden>
          Nothing saved yet. Search above for something you might want to watch.
        </p>
      </main>

      <footer class="footer">
        <div class="wrap footer-inner">
          <a class="foot-link" href="pages/analytics.html">📊 Analytics</a>
          <span>Kept in this browser, included in every backup</span>
          <span><a href="<%= vault.home %>">← <%= vault.back %></a></span>
        </div>
      </footer>
    </div>

    <script src="assets/js/config.js"></script>
    <script src="assets/js/store.js"></script>
    <script src="assets/js/cloud.js"></script>
    <script src="assets/js/uservault.js"></script>
    <script src="assets/js/lightbox.js"></script>
    <script src="assets/js/modes.js"></script>
    <script src="assets/js/wishlist.js"></script>
    <script src="assets/js/account.js"></script>
  </body>
</html>
