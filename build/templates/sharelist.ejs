<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <base href="<%= base %>" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%- include("partials/head") %>
    <title>Share a list - Media Vault</title>
    <meta name="description" content="Build a list of films and hand it out with a link or a short code." />
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/universes.css" />
    <link rel="stylesheet" href="assets/css/home.css" />
    <link rel="icon" href="assets/img/brand/logo.svg" type="image/svg+xml" />
  </head>
  <body data-mode="movie" class="u-sharelist">
    <div class="page">
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="index.html">
            <%- include("partials/logo") %>
            <span>Media Vault</span>
          </a>
          <span class="crumb">/ Share a list</span>
          <span class="topbar-spacer"></span>
          <span id="acctChip"></span>
        </div>
      </header>

      <main class="wrap">
        <section class="hero">
          <p class="eyebrow reveal">Share a list</p>
          <h1 class="reveal" style="--d:60ms">
            Pass along<br /><span class="hero-accent">what's worth watching.</span>
          </h1>
          <p class="lede reveal" style="--d:130ms">
            Build a list, get a code and a link back for it. Anyone with either can open it -
            no account needed on either end.
          </p>
        </section>

        <div class="sl-tabs reveal" style="--d:180ms">
          <button class="chip active" data-tab="create">Create a list</button>
          <button class="chip" data-tab="open">Open a shared list</button>
        </div>

        <section id="slCreate" class="sl-panel">
          <div id="slCreateBody"></div>
        </section>

        <section id="slOpen" class="sl-panel" hidden>
          <div id="slOpenBody"></div>
        </section>

        <section class="sl-saved-wrap">
          <h2>Saved lists</h2>
          <div id="slSaved" class="sl-saved"></div>
        </section>
      </main>

      <footer class="footer">
        <div class="wrap footer-inner">
          <a class="foot-link" href="pages/analytics.html">Analytics</a>
          <span>Media Vault</span>
          <span><a href="index.html">← All universes</a></span>
        </div>
      </footer>
    </div>

    <script src="assets/js/config.js"></script>
    <script src="assets/js/store.js"></script>
    <script src="assets/js/cloud.js"></script>
    <script src="assets/js/data/_films.js"></script>
    <script src="assets/js/modes.js"></script>
    <script src="assets/js/sharelist.js"></script>
    <script src="assets/js/account.js"></script>
  </body>
</html>
