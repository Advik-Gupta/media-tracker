<meta name="color-scheme" content="dark light" />
    <style>@view-transition { navigation: auto; }</style>
    <meta name="theme-color" content="#121110" />
    <script>
      (function () {
        var t = "system";
        try { t = localStorage.getItem("mediavault.theme") || "system"; } catch (e) {}
        var light = t === "light" || (t === "system" && window.matchMedia("(prefers-color-scheme: light)").matches);
        document.documentElement.dataset.theme = light ? "light" : "dark";
        document.documentElement.dataset.themePref = t;
      })();
      (function () {
        var p = location.pathname;
        var here = /\/pages\/shows(\/|\.html)/.test(p) ? 1 : /\/pages\/anime(\/|\.html)/.test(p) ? 2 : 0;
        if (/\/pages\/(account|analytics|sharelist)\.html/.test(p)) return;
        var was = null;
        try {
          was = sessionStorage.getItem("mv.lib");
          sessionStorage.setItem("mv.lib", String(here));
        } catch (e) {}
        if (was !== null && Number(was) !== here)
          document.documentElement.dataset.nav = here > Number(was) ? "forward" : "back";
        document.documentElement.dataset.lib = ["movie", "show", "anime"][here];
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
