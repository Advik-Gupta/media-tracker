# ============================================================
# Media Vault — environment
#
# Copy to .env.local for local use, and set the same two values
# in Vercel under Settings → Environment Variables.
#
# Both are read at BUILD time and written into
# assets/js/config.js, because the site is static and cannot read
# the environment in a browser. Re-deploy after changing them.
# ============================================================

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → anon / public
#
# This one is meant to be public: it ends up in the page, and row
# level security is what actually protects the data. Do NOT put
# the service_role key here — it bypasses every policy.
SUPABASE_ANON_KEY=
